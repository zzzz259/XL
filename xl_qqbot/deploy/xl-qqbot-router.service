[Unit]
Description=XL QQ Bot - event router (gateway, tier forwarding, pushes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/xl_qqbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/admin/xl_qqbot/.venv/bin/python -m bot_app.router
Restart=on-failure
RestartSec=10
CPUQuota=50%
MemoryMax=256M
Nice=10

[Install]
WantedBy=default.target

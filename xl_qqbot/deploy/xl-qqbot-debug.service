[Unit]
Description=XL QQ Bot - debug tier service (port 8781)
After=network-online.target xl-qqbot-router.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/xl_qqbot-debug
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/admin/xl_qqbot-debug
# 共享主项目 venv，PYTHONPATH 指向本 worktree 源码
ExecStart=/home/admin/xl_qqbot/.venv/bin/python -m bot_app.service --tier debug --port 8781
Restart=on-failure
RestartSec=10
CPUQuota=30%
MemoryMax=200M
Nice=10

[Install]
WantedBy=default.target

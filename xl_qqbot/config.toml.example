[bot]
# QQ 开放平台凭据只需配置在 Gateway（或旧单进程模式）；Bot worker/notifier/jobs 可留空。
# 创建机器人在 https://bot.open.qq.com
appid = ""
secret = ""

[instance]
# 当前 Bot 进程的唯一实例 ID；与 Gateway 的 [router.instance_ports] 键对应。
id = "default"

[watch]
# 上游 xl_updata_server 产出的 outbox 根目录
outbox_dir = "/home/admin/xl_updata_server/data/outbox"
# 轮询间隔（秒），默认 30
interval_seconds = 30
# 本机持久化目录：分发记录、学到的群 openid 等
data_dir = "/home/admin/xl_qqbot/data"
# @机器人+角色名 查询用的角色数据与图鉴图片目录
character_data = "/home/admin/xl_updata_server/data/character_data/current.json"
versions_dir = "/home/admin/xl_updata_server/data/versions"
# automation jobs 读取此实例配置的全部更新来源；来源名称只用于事件命名空间。
# minimum_tier 是旧配置字段，仅为迁移兼容保留，不再作为群投递门禁。
# [[watch.update_sources]]
# name = "main"
# outbox_dir = "/home/admin/xl_updata_server/data/outbox"
# minimum_tier = "production"
# [[watch.update_sources]]
# name = "test"
# outbox_dir = "/home/admin/xl_updata_server-test/data/outbox"
# minimum_tier = "test"

[target]
# 目标群 openid 列表（可选覆盖）。
# 留空（默认）= 发给所有已知的机器人所在群（已学习列表 + 后续事件学习）。
# 手填列表 = 只发这些群，忽略学习列表。
group_openids = []
# 是否监听群事件（被添加进群、被@消息）自动登记群 openid。默认开启。
auto_learn_from_events = true

[upload]
# 图片文件的公网可访问 URL 前缀（可选）。
# 若配置，bot 会把本地文件路径映射成该 URL 下的可下载地址，再调用 SDK 的 URL 直传接口。
# 例如：https://your-domain.com/xl_outbox
# 留空则使用官方分片上传接口直接上传本地文件（未经验证，需凭据实测）。
file_base_url = ""

[message]
# 发送文字模板，可用变量 {version} {name} {file_name}
# 留空（默认）= 只发图不配文字
template = ""

[groups]
# 旧版按群分环境的兼容字段；新部署请用 router.group_instances 直接指定唯一归属。
debug = []
test = []

[router]
# Gateway Router 转发 worker 的端口与超时；部署 API 由 bot_app.deployment_service 启动。
# Legacy compatibility only; current router forwards debug groups to test_port.
debug_port = 8781
test_port = 8782
production_port = 8783
forward_timeout = 8
# 部署控制 API 仅监听 127.0.0.1，部署控制进程使用此端口。
deployment_control_port = 8784
# 使用至少 32 个随机字符；需与 gateway.control_token、notification.api_token 相同。
# 可用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成。
deployment_token = ""

# 直接指定群组唯一归属的实例。重复群组键会被 TOML 拒绝。
[router.group_instances]
# "<group_openid>" = "<instance_id>"

# 每个实例的本机事件入口端口；必须覆盖 group_instances 中的全部目标。
[router.instance_ports]
# default = 8812

[gateway]
# Gateway 的维护/排空和唯一 QQ 收发 API，仅监听 127.0.0.1。
control_port = 8785
# 填入与 router.deployment_token 相同的内网 Bearer token；不要提交真实 token。
control_token = ""

# 每个 Bot 实例独立的 Gateway transport Bearer token。显式配置群路由时，必须为每个实例配置不同 token。
[gateway.instance_tokens]
# default = ""

[notification]
# 各实例通知服务共用内网 Bearer token；与 router.deployment_token 相同。
# 请在服务器外部配置中填入至少 32 个随机字符，不要提交真实 token。
api_token = ""
test_port = 8786
production_port = 8787
# 每个实例独立的通知服务端口。
[notification.instance_ports]
# default = 8788

[server_status]
# 游戏服务器状态采样；由每个实例自己的配置开关控制。默认关闭。无 provider 时不会发起请求。
enabled = false
# 常规状态探测间隔；候选变化会按 confirm_delay_seconds 快速复查。
interval_seconds = 30
confirm_delay_seconds = 3
# 旧配置字段，读取但不再筛选群组；实际目标来自 [target].group_openids。
recipient_tiers = []

[bilibili]
# B 站 UP 主动态/视频监视。enabled=false 可关闭。
enabled = true
# 常规轮询间隔（秒），默认 300
interval_seconds = 300
# 定时密集检测：每天 burst_times 起持续 burst_window_seconds，期间每 burst_interval_seconds 检测一次。
# 留空（burst_times = []）退回纯 interval_seconds 模式。
burst_times = ["10:00", "17:00"]
burst_window_seconds = 300
burst_interval_seconds = 60
# 密集窗口判定用的时区
timezone = "Asia/Shanghai"
# 登录态 SESSDATA（必填，否则接口被风控返回 412）。
# 获取方式：浏览器登录 bilibili.com → F12 → 应用/存储 → Cookies → SESSDATA 的值。
sessdata = ""

# 监视目标（可多个，每个 [[bilibili.targets]] 一个）。
# mode = "full"：图文动态发全文+逐张原图，视频发一行通知（官方号用）
# mode = "notice"：图文和视频都只发一行通知，不拉详情、不下图
# name 留空则运行时自动解析 UP 主名（acc/info，失败回退视频 author，再失败用 mid），解析结果缓存
[[bilibili.targets]]
mid = "3537105431038140"
name = "星落官方"
mode = "full"

[[bilibili.targets]]
mid = "11310554"
name = ""
mode = "notice"

[[bilibili.targets]]
mid = "1623229430"
name = ""
mode = "notice"

[server]
environment = "main" # 旧配置兼容标签，不参与功能开关
instance_id = "default" # 当前 updater 实例的显式身份
timezone = "Asia/Shanghai"
normal_interval_seconds = 3600
burst_interval_seconds = 60
burst_duration_seconds = 1200
# 固定周期起点；服务重启不会重新计算锚点。每 21 天周五 10:00 进入密集检查。
burst_anchor = "2026-10-09T10:00:00+08:00"

[polling]
enabled = true # 对任何实例直接生效；需要停用时设为 false

[api]
enabled = true # 本机控制接口；启动前需由 systemd EnvironmentFile 提供 token
host = "127.0.0.1"
port = 8790 # 每个实例配置独立监听端口
token_env = "XL_UPDATE_API_TOKEN"

[paths]
data_dir = "data"
java_bin = "java"
unluac_jar = "../xl_updata_tool/tools/lua/unluac.jar"
unluac_opmap = "../xl_updata_tool/tools/lua/opmap"
# Node 可执行文件路径，用于调用 renderer/ 下的长图渲染器。
node_bin = "node"
# Optional CJK font path. Empty uses the renderer's system-font search.
character_card_font = ""

[cdn]
base = "https://elpis.17995cdn.com/Android/Bundles"
categories = ["Arts", "Data"]

# false 时只建角色数据库，完全不渲染图鉴长图（弱机省 CPU/磁盘）
[cards]
enabled = true

# 增量立绘导出：默认关闭。启用后随每次更新在 Lua/图鉴处理后逐套生成完整 2x PNG。
# 首次启用只记录指纹（not_generated），不自动补历史；失败项下轮恢复，不重复 start/finish。
[portraits]
enabled = false
# Tool 源码根目录（含 app/ 包），默认取仓库相邻检出的 xl_updata_tool
# tool_dir = "../xl_updata_tool"
# 渲染入口子进程解释器；空串使用当前解释器
# python_bin = ""
# dotnet_path = "tools/portrait/dotnet"
# scene_cli_path = "tools/portrait/PortraitSceneCLI.dll"
# query_cli_path = ""      # 可选；缺失时渲染仍可完成，仅元数据不完整
# xvfb_run_path = ""       # 可选；无 DISPLAY 的 Linux 需要，留空自动从 PATH 查找
# assetstudio_cli = "tools/assetstudio/AssetStudioCLI"   # 生成 assets_map.json 所需
# assetstudio_dotnet = ""  # CLI 为 dll 时填写 dotnet 可执行文件
# work_dir = ""            # 默认 <data_dir>/portrait_work
# outbox_dir = ""          # 默认 <data_dir>/portrait_outbox
# memory_max_bytes = 536870912
# memory_high_bytes = 402653184
# cpu_affinity = [0]
# timeout_seconds = 900        # 单套原生渲染超时
# job_timeout_seconds = 3600   # 单套渲染入口子进程总超时（必须大于 timeout_seconds，否则配置校验拒绝）
# map_timeout_seconds = 900    # AssetStudio map 生成超时
# png_working_rows = 128

# 已知卡池排期与普通角色首次复刻预测；每天北京时间05:00检查
[rerun_schedule]
enabled = true
forecast_limit = 20
# 资源周期：周五自然日起每21天一期，映射到下周二10:00至三周后周二05:00。
cycle_anchor_date = "2026-11-20"
# 仅首次建立calendar.json时归档旧历史，不是后续解析的永久截止线。
history_through_gacha_id = 24000087

# 仅用于初次迁移的可靠历史归属。之后新池按首次资源更新事件自动登记。
[[rerun_schedule.bootstrap_cycles]]
gacha_ids = [24000088, 24000089]
cycle_start = "2026-10-09"
source_version = "134359843258232660"
source = "previous_user_confirmed_anchor"

[[rerun_schedule.bootstrap_cycles]]
gacha_ids = [24000090, 24000091]
cycle_start = "2026-10-30"
source_version = "134378035139437790"
source = "retained_version_and_update_events"

# 可选：以 Gacha ID 精确纠偏；每项必须提供可审计来源。
# [[rerun_schedule.overrides]]
# gacha_id = 24000041
# pool_kind = "normal"
# character_id = 10000197
# source = "已核对的游戏公告/运营记录"
# exclude_from_prediction = false

[security]
assetbundle_key = "yunguihaowan1234"

[portraits]
enabled = false
basic_fallback = false

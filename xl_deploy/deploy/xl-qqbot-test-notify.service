[Unit]
Description=XL QQ Bot test notification delivery service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/xl_qqbot-test
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/admin/xl_deploy/current/test/xl_qqbot
ExecStart=/home/admin/xl_deploy/current/test/.venvs/xl-qqbot-test-notify.service/bin/python -P -m bot_app.notification_service --instance-id test
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
CPUQuota=20%
MemoryMax=160M
Nice=10

[Install]
WantedBy=default.target

[Unit]
Description=XL character update backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/xl_updata_server
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/admin/xl_deploy/current/main/.venvs/xl-updata-server.service/bin/python /home/admin/xl_deploy/current/main/xl_updata_server/run_server.py --config /home/admin/xl_updata_server/config.toml
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
Nice=10
CPUQuota=100%
MemoryHigh=700M
MemoryMax=1G

[Install]
WantedBy=default.target

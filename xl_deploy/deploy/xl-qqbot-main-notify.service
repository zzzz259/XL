[Unit]
Description=XL QQ Bot main notification delivery service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/xl_qqbot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/admin/xl_deploy/current/main/xl_qqbot
ExecStart=/home/admin/xl_deploy/current/main/.venvs/xl-qqbot-main-notify.service/bin/python -P -m bot_app.notification_service --tier production
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
CPUQuota=20%
MemoryMax=160M
Nice=10

[Install]
WantedBy=default.target

# Copy to /home/admin/xl_deploy/config.toml and edit all paths.
# GitHub credentials come from the mode-600 EnvironmentFile secrets.env.
# Relative paths resolve against this config file; paths below are explicit absolutes.
[github]
owner = "YOUR_GITHUB_OWNER"
repo = "YOUR_REPOSITORY"

[deployment]
root = "/home/admin/xl_deploy"
# Set to an operator-verified local Git checkout; do not assume an old service tree.
repository = "/home/admin/REPLACE_WITH_REVIEWED_REPOSITORY_CHECKOUT"
state_dir = "/home/admin/xl_deploy/state"
releases_root = "/home/admin/xl_deploy/releases"
current_root = "/home/admin/xl_deploy/current"
# Existing backend config/data are external to releases and remain in place.
backend_config = "/home/admin/xl_updata_server/config.toml"
backend_data = "/home/admin/xl_updata_server/data"
test_backend_config = "/home/admin/xl_updata_server-test/config.toml"
test_backend_data = "/home/admin/xl_updata_server-test/data"

[router]
base_url = "http://127.0.0.1:8784"
# Create separately, enter the matching router bearer value, chmod 600.
token_file = "/home/admin/.config/xl_deploy/router.token"

# Branches are fixed in code: debug, test, main. The timer invokes one poll pass.

# Optional hand-maintained inventory. Without this section the legacy fixed
# test/main unit mapping remains available for existing installations.
# Units must already exist and use current/<watch_ref> plus their external config.
# instance_id is a stable identity; watch_ref selects code, not capabilities.
[inventory.gateway]
unit = "xl-qqbot-router.service"
watch_ref = "main"
config_path = "/home/admin/xl_gateway/config.toml"
listen_port = 8785
data_roots = ["/home/admin/xl_gateway/data"]
# Runtime watch.data_dir must remain within these roots.
# debug is a CI-only ref; runtime watch_ref must be test or main.

[[inventory.instances]]
instance_id = "test-a"
watch_ref = "test"
config_path = "/home/admin/xl_instances/test-a/config.toml"
data_roots = ["/home/admin/xl_instances/test-a/data"]
groups = ["REPLACE_TEST_A_GROUP"]
units = { bot = "xl-test-a.service", notify = "xl-test-a-notify.service", jobs = "xl-test-a-jobs.service" }
listen_ports = { bot = 8811, notify = 8812 }

[[inventory.instances]]
instance_id = "test-b"
watch_ref = "test"
config_path = "/home/admin/xl_instances/test-b/config.toml"
data_roots = ["/home/admin/xl_instances/test-b/data"]
groups = ["REPLACE_TEST_B_GROUP"]
units = { bot = "xl-test-b.service", notify = "xl-test-b-notify.service", jobs = "xl-test-b-jobs.service" }
listen_ports = { bot = 8821, notify = 8822 }
# Add main instances, control or backend roles explicitly as needed. Each entry
# owns one config and its data roots. Bot watch.data_dir, watch.outbox_dir and
# every watch.update_sources outbox_dir must remain within that instance's roots.
# A backend-only entry uses units.backend
# and listen_ports.backend, with its matching backend config path.
# Match gateway [router.group_instances] and service config IDs/ports to this file.
